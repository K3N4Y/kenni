#!/bin/sh
set -eu

head=$(git rev-parse HEAD)
base=
check=false
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_ref:$remote_ref" in
    '(delete):'*) continue ;;
    *:refs/heads/*) ;;
    *) continue ;;
  esac

  if [ "$local_oid" != "$head" ]; then
    printf 'pre-push: check out %s before pushing it to %s.\n' "$local_ref" "$remote_ref" >&2
    exit 1
  fi

  if [ "$check" = false ]; then
    base=$remote_oid
  elif [ "$base" != "$remote_oid" ]; then
    base=
  fi
  check=true
done

[ "$check" = true ] || exit 0

if [ -n "$(git status --porcelain --untracked-files=normal)" ]; then
  printf 'pre-push: commit or stash local changes before validating the pushed commit.\n' >&2
  exit 1
fi

exec sh scripts/check-workspaces.sh "$base"
