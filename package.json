{
  "name": "projects",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "bun run lint:oxlint && turbo run lint",
    "lint:oxlint": "oxlint oxfmt.config.ts",
    "typecheck": "bun check && turbo run typecheck",
    "format": "oxfmt --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@interfere/landmines": "^0.3.1",
    "@repo/config": "workspace:*",
    "husky": "^9.1.7",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.95.0",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.3"
}
