{
  "name": "projects",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "bun run lint:root && turbo run lint",
    "lint:root": "oxlint oxfmt.config.ts",
    "typecheck": "bun run typecheck:root && turbo run typecheck",
    "typecheck:root": "bun check",
    "check": "sh scripts/check-workspaces.sh",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "agent": "bun run --cwd apps/agent start"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.3"
}
